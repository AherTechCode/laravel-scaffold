<?php

namespace {{namespace}};

{{excelImport}}
{{serviceImports}}

class {{modelName}}Service
{
    protected $repository;

    public function __construct({{modelName}}Repository $repository)
    {
        $this->repository = $repository;
    }

    public function getAll()
    {
        return $this->repository->getAll();
    }

    public function getById($id)
    {
        return $this->repository->getById($id);
    }

    public function create(array $data)
    {
        $this->assertBusinessRules('create', $data);
        $record = $this->repository->create($data);
        $this->dispatchDomainEvent('{{modelName}}Created', ['record' => $record]);
        return $record;
    }

    public function update($id, array $data)
    {
        $record = $this->repository->getById($id);
        $this->assertBusinessRules('update', $data, $record);
        $record = $this->repository->update($id, $data);
        $this->dispatchDomainEvent('{{modelName}}Updated', ['record' => $record]);
        return $record;
    }

    public function delete($id)
    {
        $record = $this->repository->getById($id);
        $this->assertBusinessRules('delete', [], $record);
        $deleted = $this->repository->delete($id);
        $this->dispatchDomainEvent('{{modelName}}Deleted', ['record' => $record]);
        return $deleted;
    }

    {{massUploadMethod}}

    public function search($column, $value)
    {
        return $this->repository->search($column, $value);
    }

    protected function assertBusinessRules(string $action, array $data = [], $record = null): void
    {
        {{businessRuleChecks}}
    }

    protected function dispatchDomainEvent(string $eventName, array $payload = []): void
    {
        event($eventName, $payload);
    }

    {{commandMethods}}
}
