public function massUpload(Request $request)
    {
        $request->validate([
            '{{uploadField}}' => 'required|file|mimes:{{uploadMimes}}|max:{{uploadMax}}',
        ]);

        $file = $request->file('{{uploadField}}');
        $uploaded = $this->service->massUpload($file);

        if ($uploaded === true) {
            return response()->json(['message' => '{{modelName}} upload successful'], 200);
        }

        return response()->json(['message' => '{{modelName}} upload failed', 'error' => $uploaded], 422);
    }
